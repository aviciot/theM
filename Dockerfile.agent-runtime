FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git ca-certificates
WORKDIR /go_src
COPY go/go.mod go/go.sum ./
RUN go mod download
COPY go/ .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /usr/local/bin/agent-runtime ./cmd/agent-runtime/

FROM alpine:3.21
RUN apk add --no-cache ca-certificates wget
COPY --from=builder /usr/local/bin/agent-runtime /usr/local/bin/agent-runtime
EXPOSE 9300
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:9300/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/agent-runtime"]
