# Copy to .env and fill in values before running docker compose up

# Base URL of the-M (reachable from the Docker container)
# On Linux: use the host IP directly, e.g. http://10.55.125.43:8088
# On Windows/Mac Docker Desktop: http://host.docker.internal:8088
THEM_URL=http://10.55.125.43:8088

# Super-admin credentials for the-M
THEM_ADMIN_USER=admin
THEM_ADMIN_PASS=

# Optional: protect the test runner UI with basic auth
TR_BASIC_AUTH_USER=
TR_BASIC_AUTH_PASS=
