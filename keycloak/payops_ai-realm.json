{
  "id": "payops_ai",
  "realm": "payops_ai",
  "displayName": "PayOps AI",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 3600,
  "loginTheme": "payops-theme",
  "userManagedAccessAllowed": false,
  "attributes": {
    "userProfileEnabled": "true",
    "unmanagedAttributePolicy": "ENABLED",
    "frontendUrl": "http://localhost:8088/auth/keycloak"
  },
  "clients": [
    {
      "clientId": "them-m",
      "name": "the-M Platform",
      "enabled": true,
      "publicClient": false,
      "secret": "them-m-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8088/auth/oidc/callback",
        "http://10.55.125.43:8088/auth/oidc/callback",
        "http://localhost:8088/*"
      ],
      "webOrigins": [
        "http://localhost:8088",
        "http://10.55.125.43:8088"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tier",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tier",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tier",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "groups": [
    { "name": "payops-admins", "path": "/payops-admins" },
    { "name": "developers",    "path": "/developers" },
    { "name": "qa",            "path": "/qa" }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@payops.ai",
      "firstName": "PayOps",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "groups": ["/payops-admins"]
    },
    {
      "username": "dev",
      "email": "dev@payops.ai",
      "firstName": "PayOps",
      "lastName": "Dev",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "groups": ["/developers"]
    },
    {
      "username": "qa",
      "email": "qa@payops.ai",
      "firstName": "PayOps",
      "lastName": "QA",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "groups": ["/qa"]
    },
    {
      "username": "alice",
      "email": "alice@payops.ai",
      "firstName": "Alice",
      "lastName": "Premium",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice123", "temporary": false }],
      "attributes": { "tier": ["premium"] }
    },
    {
      "username": "bob",
      "email": "bob@payops.ai",
      "firstName": "Bob",
      "lastName": "Standard",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob123", "temporary": false }],
      "attributes": { "tier": ["standard"] }
    }
  ]
}
