{
  "id": "them",
  "realm": "them",
  "displayName": "the-M",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "them-m",
      "name": "the-M Platform",
      "enabled": true,
      "publicClient": false,
      "secret": "them-m-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8088/auth/api/v1/auth/oidc/callback",
        "http://localhost:8088/*"
      ],
      "webOrigins": [
        "http://localhost:8088"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "testuser@example.com",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-them"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "default-roles-them",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization"],
          "client": {}
        }
      }
    ]
  },
  "scopeMappings": [],
  "clientScopeMappings": {},
  "defaultRoles": ["default-roles-them"]
}
