{
  "id": "transform-demo",
  "slug": "transform-demo",
  "display_name": "Transform Demo Agent",
  "description": "Demonstrates the Transform node function chain: LLM returns fenced JSON, Transform strips fences and extracts fields.",
  "version": "1.0.0",
  "skills": [
    {
      "id": "main",
      "label": "Main",
      "steps": [
        {
          "id": "input",
          "type": "input",
          "label": "User Input",
          "config": {
            "bindings": { "text": "user_query" }
          },
          "next": ["ask-llm"],
          "position": { "x": 400, "y": 80 }
        },
        {
          "id": "ask-llm",
          "type": "llm",
          "label": "Ask LLM (returns JSON)",
          "config": {
            "provider": "anthropic",
            "model": "claude-haiku-4-5-20251001",
            "max_tokens": 300,
            "system_prompt": "You are a data extractor. Always respond with raw JSON only — no markdown, no explanation. Extract the city name, population and country from the user message.",
            "prompt_template": "Extract from: {{.user_query}}\n\nRespond with exactly this JSON structure:\n{\"city\": \"<name>\", \"population\": \"<number>\", \"country\": \"<name>\"}",
            "output_var": "llm_raw"
          },
          "next": ["extract-fields"],
          "position": { "x": 400, "y": 220 }
        },
        {
          "id": "extract-fields",
          "type": "transform",
          "label": "Extract Fields",
          "config": {
            "functions": [
              {
                "fn": "strip_fences",
                "input_var": "llm_raw",
                "output_var": "clean_json",
                "args": {}
              },
              {
                "fn": "json_path",
                "input_var": "clean_json",
                "output_var": "city",
                "args": { "path": "$.city" }
              },
              {
                "fn": "json_path",
                "input_var": "clean_json",
                "output_var": "population",
                "args": { "path": "$.population" }
              },
              {
                "fn": "json_path",
                "input_var": "clean_json",
                "output_var": "country",
                "args": { "path": "$.country" }
              },
              {
                "fn": "upper",
                "input_var": "city",
                "output_var": "city_upper",
                "args": {}
              },
              {
                "fn": "concat",
                "input_var": "city_upper",
                "output_var": "city_label",
                "args": { "prefix": "City: " }
              }
            ]
          },
          "next": ["respond"],
          "position": { "x": 400, "y": 380 }
        },
        {
          "id": "respond",
          "type": "response",
          "label": "Response",
          "config": {
            "from_var": "city_label",
            "media_type": "text/plain"
          },
          "next": [],
          "position": { "x": 400, "y": 540 }
        }
      ]
    }
  ]
}
