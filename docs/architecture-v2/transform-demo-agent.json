{
  "schema_version": 1,
  "agent_slug": "transform-demo",
  "agent_root": {
    "display_name": "Transform Demo Agent",
    "description": "Demonstrates the Transform node: LLM returns fenced JSON, Transform strips fences and extracts fields.",
    "version": "1.0.0",
    "capabilities": { "streaming": false, "push_notifications": false }
  },
  "skills": [
    {
      "skill_id": "main",
      "name": "Extract City Info",
      "description": "Ask LLM to return city data as JSON, then extract fields using Transform.",
      "input_modes": ["text/plain"],
      "output_modes": ["text/plain"],
      "position": { "x": 300, "y": 260 },
      "steps": [
        {
          "id": "input",
          "type": "input",
          "label": "User Input",
          "config": {
            "bindings": { "text": "user_query" }
          },
          "next": ["ask-llm"],
          "position": { "x": 300, "y": 80 }
        },
        {
          "id": "ask-llm",
          "type": "llm",
          "label": "Ask LLM — returns JSON",
          "config": {
            "provider": "anthropic",
            "model": "claude-haiku-4-5-20251001",
            "max_tokens": 200,
            "system_prompt": "You are a data extractor. Always respond with raw JSON only — no markdown fences, no explanation.",
            "prompt_template": "Extract from this text: {{.user_query}}\n\nReturn exactly this JSON:\n{\"city\": \"<name>\", \"population\": \"<number>\", \"country\": \"<name>\"}",
            "output_var": "llm_raw"
          },
          "next": ["extract-fields"],
          "position": { "x": 300, "y": 220 }
        },
        {
          "id": "extract-fields",
          "type": "transform",
          "label": "Extract Fields",
          "config": {
            "exposed_vars": ["city_label"],
            "functions": [
              {
                "fn": "strip_fences",
                "input_var": "llm_raw",
                "output_var": "clean_json",
                "args": {}
              },
              {
                "fn": "json_path",
                "input_var": "clean_json",
                "output_var": "city",
                "args": { "path": "$.city" }
              },
              {
                "fn": "json_path",
                "input_var": "clean_json",
                "output_var": "population",
                "args": { "path": "$.population" }
              },
              {
                "fn": "json_path",
                "input_var": "clean_json",
                "output_var": "country",
                "args": { "path": "$.country" }
              },
              {
                "fn": "upper",
                "input_var": "city",
                "output_var": "city_upper",
                "args": {}
              },
              {
                "fn": "concat",
                "input_var": "city_upper",
                "output_var": "city_label",
                "args": { "prefix": "City: " }
              }
            ]
          },
          "next": ["respond"],
          "position": { "x": 300, "y": 380 }
        },
        {
          "id": "respond",
          "type": "response",
          "label": "Response",
          "config": {
            "from_var": "city_label",
            "media_type": "text/plain"
          },
          "next": [],
          "position": { "x": 300, "y": 540 }
        }
      ]
    }
  ]
}
