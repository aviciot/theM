FROM golang:1.25-alpine AS builder

WORKDIR /build

RUN apk add --no-cache git

COPY go/go.mod ./
RUN go mod tidy

COPY go/ ./
RUN go mod tidy && \
    go test ./internal/middleware/... ./internal/middleware/av/... && \
    CGO_ENABLED=0 GOOS=linux go build -o /them-middleware-worker ./cmd/middleware-worker/

# ── Runtime image ──────────────────────────────────────────────────────────────
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /them-middleware-worker ./them-middleware-worker

CMD ["./them-middleware-worker"]
