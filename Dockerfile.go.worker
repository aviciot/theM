FROM golang:1.23-alpine AS builder

WORKDIR /build

RUN apk add --no-cache git

COPY go/go.mod ./
RUN go mod tidy

COPY go/ ./
RUN go mod tidy && \
    go test ./... && \
    CGO_ENABLED=0 GOOS=linux go build -o /them-worker ./cmd/worker/

# ── Runtime image ──────────────────────────────────────────────────────────────
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /them-worker ./them-worker

CMD ["./them-worker"]
